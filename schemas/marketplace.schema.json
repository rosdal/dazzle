{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rosdal/dazzle/schemas/marketplace.schema.json",
  "title": "Claude Code marketplace manifest (.claude-plugin/marketplace.json)",
  "description": "The subset of the Claude Code marketplace manifest that Dazzle uses, kept strict so typos fail CI.",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "owner": { "$ref": "plugin.schema.json#/definitions/person" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "pluginRoot": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "description", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "source": { "type": "string", "pattern": "^\\./" },
          "description": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          },
          "author": { "$ref": "plugin.schema.json#/definitions/person" },
          "homepage": { "type": "string", "format": "uri" },
          "repository": { "type": "string", "format": "uri" },
          "license": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "strict": { "type": "boolean" }
        }
      }
    }
  }
}
